        stroke: #070709;
      }

      .cls-1, .cls-2, .cls-4 {
        stroke-linecap: round;
      }

      .cls-1, .cls-2, .cls-4, .cls-5, .cls-6 {
        stroke-width: 5px;
      }

      .cls-1, .cls-4, .cls-6, .cls-7 {
        fill: #fff;
      }

      .cls-2, .cls-3, .cls-5 {
        fill: #070709;
      }

      .cls-3, .cls-7 {
        stroke-width: 4px;
      }

      .cls-4, .cls-5, .cls-6, .cls-7 {
        stroke-miterlimit: 10;
      }

      .cls-8 {
        fill: #cedee6;
      }
    </style>
